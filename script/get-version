#!/usr/bin/env bash
# The workspace version, as cargo sees it. Every other script and the CI tag check read it from here
# so there is exactly one source of truth (`[workspace.package] version` in the root Cargo.toml).
set -euo pipefail
# shellcheck source=script/lib/release.sh
source "$(dirname "$0")/lib/release.sh"

crate_version
