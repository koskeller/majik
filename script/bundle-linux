#!/usr/bin/env bash
# Build the Linux packages: a tarball with an install script, and an AppImage.
#
#   script/bundle-linux
#
# The tarball deliberately bundles no shared libraries the way Zed's does: Majik links no
# third-party dylibs (openh264 is vendored, SQLite is bundled, TLS is rustls), so it only needs
# the system packages listed in its README. The AppImage is the download-and-run experience:
# one file, no install; linuxdeploy copies in the few system libraries the binary links
# (xcb, xkbcommon, ALSA, libstdc++) and leaves glibc and the GPU driver to the machine.
set -euo pipefail

# linuxdeploy's own release, which carries the appimagetool it runs. Pinned: a "continuous" build
# would change under the release.
LINUXDEPLOY_VERSION="1-alpha-20251107-1"
# shellcheck source=script/lib/release.sh
source "$(dirname "$0")/lib/release.sh"
cd "$(repo_root)"

target="$(rustc --version --verbose | sed -n 's/^host: //p')"
arch="$(uname -m)"
version="$(crate_version)"

echo "Building Majik ${version} (${RELEASE_CHANNEL}) for ${target}"

# Everything below this line is a stable-channel build.
stamp_channel
cargo build --locked --release -p majik-app --target "$target"

binary="target/${target}/release/majik"
require_channel_marker "$binary" "$RELEASE_CHANNEL"
write_symbols "$binary" "target/majik-${target}.sym"

# The bundle id doubles as the icon and .desktop file name, so the desktop entry and the window's
# Wayland app id agree.
APP_ID="com.app.majik"
APP_NAME="Majik"
export APP_ID APP_NAME

stage="target/linux/majik-linux-${arch}"
rm -rf "$stage"
mkdir -p "$stage/bin" "$stage/share/applications"

cp "$binary" "$stage/bin/majik"
strip "$stage/bin/majik" 2> /dev/null || llvm-objcopy --strip-debug "$stage/bin/majik"

for size in 512 256 128; do
    mkdir -p "$stage/share/icons/hicolor/${size}x${size}/apps"
    cp "packaging/linux-icons/${size}.png" "$stage/share/icons/hicolor/${size}x${size}/apps/${APP_ID}.png"
done

envsubst < packaging/majik.desktop.in > "$stage/share/applications/${APP_ID}.desktop"
cp packaging/linux-install.sh "$stage/install.sh"
chmod +x "$stage/install.sh"
sed "s/__VERSION__/${version}/g" packaging/linux-readme.md > "$stage/README.md"
# GPL-3 asks that the licence travel with every binary we hand out.
cp LICENSE NOTICE "$stage/"

archive="target/majik-linux-${arch}.tar.gz"
rm -f "$archive"
tar -czf "$archive" -C "$(dirname "$stage")" "$(basename "$stage")"

appimage="target/majik-linux-${arch}.AppImage"
appdir="target/linux/AppDir"
linuxdeploy="target/linux/linuxdeploy-${arch}.AppImage"
if [[ ! -x "$linuxdeploy" ]]; then
    curl --silent --show-error --fail --location --retry 5 \
        --output "$linuxdeploy" \
        "https://github.com/linuxdeploy/linuxdeploy/releases/download/${LINUXDEPLOY_VERSION}/linuxdeploy-${arch}.AppImage"
    chmod +x "$linuxdeploy"
fi
rm -rf "$appdir" "$appimage"
# The CI container has no FUSE, so linuxdeploy (and the appimagetool it runs) unpack themselves
# first. The desktop file is the tarball's, whose `Exec=majik` is what AppRun resolves; the icon
# is named after the app id so the desktop entry's `Icon=` finds it.
APPIMAGE_EXTRACT_AND_RUN=1 OUTPUT="$appimage" VERSION="$version" "$linuxdeploy" \
    --appdir "$appdir" \
    --executable "$stage/bin/majik" \
    --desktop-file "$stage/share/applications/${APP_ID}.desktop" \
    --icon-file "packaging/linux-icons/512.png" --icon-filename "$APP_ID" \
    --output appimage
chmod +x "$appimage"

echo
echo "Built ${archive} and ${appimage} (Majik ${version}, ${RELEASE_CHANNEL}, ${arch})"
