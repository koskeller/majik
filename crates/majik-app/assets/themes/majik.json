        "secondary.active.background": "#414141",
        "secondary.foreground": "#e6e6e6",
        "primary.background": "#e6e6e6",
        "primary.hover.background": "#f2f2f2",
        "primary.active.background": "#cfcfcf",
        "primary.foreground": "#1a1a1a",
        "border": "#232323",
        "input.border": "#585858",
        "ring": "#9a9a9a",
